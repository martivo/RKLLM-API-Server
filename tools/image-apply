#!/usr/bin/env python3
"""Apply one image update that the user asked for.

    image-apply [--dry-run] <image-or-service> [new-tag] [compose-file]

    image-apply haproxy:3.3.17 3.4.7     change the tag, then pull and recreate
    image-apply python:3.12-slim 3.13-slim   change a Dockerfile base, rebuild
    image-apply grafana/grafana          same tag: pull the newest image, recreate
    image-apply grafana                  the same, by service name

With a new tag, every `image:` line in the compose file and every FROM /
COPY --from in its build contexts that uses the image is rewritten.  Each file
is first copied to <file>.bak-YYYYmmdd-HHMMSS.  Then the affected services
are pulled or rebuilt and recreated with `docker compose up -d`.

Only ever run this for an image the user named.  image-updates never changes
anything; this command is the only one that does.
"""
import importlib.machinery
import importlib.util
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error

_here = os.path.dirname(os.path.realpath(__file__))
_loader = importlib.machinery.SourceFileLoader("image_updates", os.path.join(_here, "image-updates"))
iu = importlib.util.module_from_spec(importlib.util.spec_from_loader("image_updates", _loader))
_loader.exec_module(iu)


def norm(ref):
    """Canonical form for comparing image references: 'grafana/grafana' == 'grafana/grafana:latest'."""
    return iu.parse_ref(ref)


def with_tag(ref, tag):
    """Replace (or add) the tag of an image reference, keeping registry and name."""
    ref = ref.split("@")[0]
    head, sep, last = ref.rpartition("/")
    return f"{head}{sep}{last.split(':')[0]}:{tag}"


def rewrite(path, target, new_tag, pattern, dry_run):
    """Rewrite image references matching target on lines matching pattern.

    Returns the list of 'old -> new' changes; backs the file up before writing."""
    with open(path, encoding="utf-8") as fh:
        lines = fh.readlines()
    changes = []
    for i, line in enumerate(lines):
        m = re.match(pattern, line, re.IGNORECASE)
        if not m:
            continue
        ref = m.group("ref")
        if "$" in ref or norm(ref) != target:
            continue
        new_ref = with_tag(ref, new_tag)
        lines[i] = line[:m.start("ref")] + new_ref + line[m.end("ref"):]
        changes.append(f"{ref} -> {new_ref}")
    if changes and not dry_run:
        backup = f"{path}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(path, backup)
        with open(path, "w", encoding="utf-8") as fh:
            fh.writelines(lines)
        print(f"Backup: {backup}")
    for change in changes:
        print(f"{'Would change' if dry_run else 'Changed'} {path}: {change}")
    return changes


def compose(compose_file, *args, dry_run=False):
    cmd = ["docker", "compose", "-f", compose_file] + list(args)
    if dry_run:
        print("Would run: " + " ".join(cmd))
        return True
    print("$ " + " ".join(cmd), flush=True)
    proc = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, text=True)
    tail = [l for l in proc.stdout.strip().splitlines() if l.strip()][-4:]
    if tail:
        print("\n".join(tail))
    return proc.returncode == 0


def main():
    dry_run = "--dry-run" in sys.argv
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if not args:
        sys.exit(__doc__.strip().split("\n\n")[1])
    target_arg = args[0]
    new_tag = compose_file = None
    for extra in args[1:]:
        if extra.endswith((".yml", ".yaml")) or "/" in extra:
            compose_file = extra
        else:
            new_tag = extra.lstrip(":")
    compose_file = compose_file or "/root/compose/docker-compose.yml"
    try:
        project, services = iu.load_services(compose_file)
    except Exception as exc:
        sys.exit(f"Cannot read {compose_file}: {exc}")

    # What does the argument name: a service, or an image used somewhere?
    by_name = [s for s in services if s["name"] == target_arg]
    if by_name and new_tag and by_name[0]["context"] is None and by_name[0]["image"]:
        target_arg = by_name[0]["image"]   # "haproxy 3.4.7" by service name
        by_name = []
    if by_name and not new_tag:
        affected = by_name
        target = None
    else:
        target = norm(target_arg)
        affected = []
        for svc in services:
            refs = []
            if svc["context"] is None and svc["image"]:
                refs = [svc["image"]]
            elif svc["context"] is not None:
                try:
                    refs = iu.dockerfile_bases(svc["dockerfile"])
                except OSError:
                    refs = []
            if any(norm(r) == target for r in refs):
                affected.append(svc)
    if not affected:
        used = sorted({s["image"] for s in services if s["image"] and s["context"] is None})
        sys.exit(f"Nothing in {compose_file} uses '{target_arg}'. Images in use: {', '.join(used)}")

    if not dry_run and iu.docker("version", "--format", "{{.Server.Version}}") is None:
        sys.exit("No docker access (mount /var/run/docker.sock); nothing was changed.")

    # Never recreate the container this command runs in: it would kill itself half way.
    me = socket.gethostname()
    for svc in affected:
        ids = iu.docker("compose", "-f", compose_file, "ps", "-q", svc["name"]) or ""
        if any(cid.startswith(me) for cid in ids.split()):
            sys.exit(f"Service {svc['name']} is the container this agent runs in. "
                     "Update it from the host; nothing was changed.")

    if new_tag:
        registry, repo, old_tag = target
        if new_tag == old_tag:
            sys.exit(f"{target_arg} already uses tag {new_tag}; nothing was changed.")
        try:
            iu.remote_image(registry, repo, new_tag)
        except urllib.error.HTTPError as exc:
            sys.exit(f"Tag {new_tag} does not exist for {repo} (HTTP {exc.code}); nothing was changed.")
        except (urllib.error.URLError, OSError, ValueError, KeyError) as exc:
            sys.exit(f"Could not verify tag {new_tag} ({exc}); nothing was changed.")
        changed = rewrite(compose_file, target, new_tag,
                          r"\s*image:\s*[\"']?(?P<ref>[^\"'\s#]+)", dry_run)
        for dockerfile in sorted({s["dockerfile"] for s in affected if s["context"] is not None}):
            changed += rewrite(dockerfile, target, new_tag,
                               r"\s*(?:FROM\s+(?:--\S+\s+)*|COPY\s+.*--from=)(?P<ref>\S+)", dry_run)
        if not changed:
            sys.exit("Found the image but could not rewrite it (variable in the reference?); "
                     "nothing was changed.")

    ok = True
    for svc in affected:
        name = svc["name"]
        if svc["context"] is None:
            ok = compose(compose_file, "pull", name, dry_run=dry_run) and ok
        else:
            ok = compose(compose_file, "build", "--pull", name, dry_run=dry_run) and ok
        if not ok:
            break
        ok = compose(compose_file, "up", "-d", name, dry_run=dry_run) and ok
    names = ", ".join(s["name"] for s in affected)
    if dry_run:
        print(f"Dry run only; nothing was changed. Services: {names}")
    elif ok:
        print(f"DONE: updated and recreated {names}.")
    else:
        print(f"FAILED while updating {names}. "
              + ("Restore the files from the backups listed above and run this again."
                 if new_tag else "No files were changed."))
        sys.exit(1)


if __name__ == "__main__":
    main()
